[Unit]
Description=Prism kernel Telegram build bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keysa
WorkingDirectory=/home/keysa/Prism-Project/android_kernel_asus_sdm660-4.19
EnvironmentFile=/home/keysa/Prism-Project/prism-bot.env
ExecStart=/usr/bin/python3 /home/keysa/Prism-Project/android_kernel_asus_sdm660-4.19/scripts/prism-telegram-bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
